				float2 ParallaxalphaUV810( float2 UV, float3 V, float Front, float Back, float A )
				{
					float scale=V.z>=0 ? Front : Back; return UV+(V.xy/max(abs(V.z),.05))*(A-.5)*scale*.01;
				}
				
				float Screendoorthreshold841( float4 P, float Tint, float On )
				{
					float2 p=floor(P.xy*_ScreenParams.xy); float threshold=frac((p.x+p.y)*.5)==.5 ? 1-Tint : Tint; return On>0 ? -1 : threshold-.5;
				}
				

				v2f VertexFunction( appdata v  )
				{
					UNITY_SETUP_INSTANCE_ID(v);
					v2f o;
					UNITY_INITIALIZE_OUTPUT(v2f,o);
					UNITY_TRANSFER_INSTANCE_ID(v,o);
					UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(o);

					float3 ase_tangentWS = UnityObjectToWorldDir( v.tangent );
					float3 ase_normalWS = UnityObjectToWorldNormal( v.normal );
					float ase_tangentSign = v.tangent.w * ( unity_WorldTransformParams.w >= 0.0 ? 1.0 : -1.0 );
					float3 ase_bitangentWS = cross( ase_normalWS, ase_tangentWS ) * ase_tangentSign;
					
					float4 ase_positionCS = UnityObjectToClipPos( v.vertex );
					float4 screenPos = ComputeScreenPos( ase_positionCS );
					o.ase_texcoord5 = screenPos;
					
					o.ase_texcoord2.xy = v.ase_texcoord.xy;
					#if defined( _ALPHA_PARALLAX_ON )
					o.ase_texcoord3.xyz = ase_tangentWS;
					#endif
					#if defined( _ALPHA_PARALLAX_ON )
					o.ase_texcoord4.xyz = ase_bitangentWS;
					#endif
					
					//setting value to unused interpolator channels and avoid initialization warnings
					o.ase_texcoord2.zw = 0;
					#if defined( _ALPHA_PARALLAX_ON )
					o.ase_texcoord3.w = 0;
					#endif
					#if defined( _ALPHA_PARALLAX_ON )
					o.ase_texcoord4.w = 0;
					#endif

					#ifdef ASE_ABSOLUTE_VERTEX_POS
						float3 defaultVertexValue = v.vertex.xyz;
					#else
						float3 defaultVertexValue = float3(0, 0, 0);
					#endif
					float3 vertexValue = defaultVertexValue;
					#ifdef ASE_ABSOLUTE_VERTEX_POS
						v.vertex.xyz = vertexValue;
					#else
						v.vertex.xyz += vertexValue;
					#endif
					v.vertex.w = 1;
					v.normal = v.normal;
					v.tangent = v.tangent;

					float3 positionWS = mul( unity_ObjectToWorld, v.vertex ).xyz;
					half3 normalWS = UnityObjectToWorldNormal( v.normal );

					o.pos = UnityObjectToClipPos( v.vertex );
