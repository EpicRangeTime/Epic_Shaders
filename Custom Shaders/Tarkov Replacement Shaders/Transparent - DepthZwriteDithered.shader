						float3 tanToWorld2 = float3( ase_tangentWS.z, ase_bitangentWS.z, IN.normalWS.xyz.z );
						float3 ase_viewVectorTS =  tanToWorld0 * ( ( unity_OrthoParams.w == 0 ) ? _WorldSpaceCameraPos - IN.worldPos.xyz : UNITY_MATRIX_V[ 2 ].xyz ).x + tanToWorld1 * ( ( unity_OrthoParams.w == 0 ) ? _WorldSpaceCameraPos - IN.worldPos.xyz : UNITY_MATRIX_V[ 2 ].xyz ).y  + tanToWorld2 * ( ( unity_OrthoParams.w == 0 ) ? _WorldSpaceCameraPos - IN.worldPos.xyz : UNITY_MATRIX_V[ 2 ].xyz ).z;
						float3 ase_viewDirTS = normalize( ase_viewVectorTS );
						float3 V810 = ase_viewDirTS;
						float Front810 = _FrontParallax;
						float Back810 = _BackParallax;
						float A810 = tex2DNode807.a;
						float2 localParallaxalphaUV810 = ParallaxalphaUV810( UV810 , V810 , Front810 , Back810 , A810 );
						staticSwitch812 = SAMPLE_TEXTURE2D( _MainTex, sampler_MainTex, localParallaxalphaUV810 ).a;
					}
					#else
					{
						staticSwitch812 = tex2DNode807.a;
					}
					#endif
					
					float4 screenPos = IN.ase_texcoord5;
					float4 ase_positionSSNorm = screenPos / screenPos.w;
					ase_positionSSNorm.z = ( UNITY_NEAR_CLIP_VALUE >= 0 ) ? ase_positionSSNorm.z : ase_positionSSNorm.z * 0.5 + 0.5;
					float4 P841 = ase_positionSSNorm;
					float Tint841 = _Tinted;
					float On841 = _ThermalVisionOn;
					float localScreendoorthreshold841 = Screendoorthreshold841( P841 , Tint841 , On841 );
					

					half Alpha = ( ( staticSwitch812 * _Color.a ) * _OpacityScale );
					half AlphaClipThreshold = localScreendoorthreshold841;

					#if defined( ASE_WRITE_DEPTH )
						IN.pos.z = IN.pos.z;
					#endif

					#ifdef _ALPHATEST_ON
						clip( Alpha - AlphaClipThreshold );
					#endif

					#if defined( ASE_WRITE_DEPTH )
						outputDepth = IN.pos.z;
					#endif

					return float4( _ObjectId, _PassValue, 1.0, 1.0 );
				}
			ENDCG
		}

		
